#!/bin/sh
# Fake FlexVolume driver "example.com/fake" for the FlexVolume -> CSI migration PoC.
# Install as /usr/libexec/kubernetes/kubelet-plugins/volume/exec/example.com~fake/fake
#
# mount <target> <json>  : bind-mounts /var/lib/fake-storage/<options.path> to <target>
# unmount <target>       : unmounts <target>
# Every invocation is appended to /var/log/fake-flex.log, so the PoC can prove
# whether the kubelet still executes this driver.

STORAGE=/var/lib/fake-storage
LOG=/var/log/fake-flex.log
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $1 $2" >> "$LOG"

ok()   { echo "{\"status\":\"Success\"$1}"; exit 0; }
fail() { echo "{\"status\":\"Failure\",\"message\":\"$1\"}"; exit 1; }

case "$1" in
  init)
    ok ',"capabilities":{"attach":false}' ;;
  mount)
    target="$2"; json="$3"
    path=$(printf '%s' "$json" | sed -n 's/.*"path":"\([^"]*\)".*/\1/p')
    [ -n "$path" ] || fail "missing option: path"
    case "$path" in */..*|..*) fail "bad path";; esac
    mkdir -p "$STORAGE/$path" "$target" || fail "mkdir failed"
    mount --bind "$STORAGE/$path" "$target" || fail "bind mount failed"
    ok ;;
  unmount)
    umount "$2" 2>/dev/null; rmdir "$2" 2>/dev/null
    ok ;;
  *)
    echo '{"status":"Not supported"}'; exit 1 ;;
esac
